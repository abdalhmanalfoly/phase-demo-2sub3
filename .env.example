# Copy to .env (never commit .env). All values are optional; defaults live in config/*.yaml.
SAGA_HOST=0.0.0.0
SAGA_PORT=8765
SAGA_LOG_DIR=logs
# Comma-separated Origins allowed to open the sensor WebSocket / call state-changing HTTP APIs.
# Empty = no Origin restriction (trusted-LAN development only).
SAGA_ALLOWED_ORIGINS=
# Optional TLS for phones (browser camera access needs a secure context). See docs/setup.md.
SAGA_TLS_CERT=certs/dev.crt
SAGA_TLS_KEY=certs/dev.key
